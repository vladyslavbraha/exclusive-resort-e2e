{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": { "@pages/*": ["src/pages/*"], "@fixtures/*": ["src/fixtures/*"] }
  },
  "include": ["src", "tests", "playwright.config.ts"]
}
